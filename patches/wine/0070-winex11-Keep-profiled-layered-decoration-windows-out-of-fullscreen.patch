From 10dc495ed956ce38d64d694f7aa31da4b1e4cabb Mon Sep 17 00:00:00 2001
From: Felix Li <2524369985@qq.com>
Date: Wed, 18 Nov 2026 08:44:17 +0800
Subject: [PATCH] winex11: Keep profiled layered decoration windows out of
 fullscreen.

Allow a per-application opt-in to identify same-process owned, layered,
transparent decoration windows by their exact Win32 class. Do not infer
fullscreen for those layers just because their geometry spans a monitor.

Mutter can also force fullscreen from a monitor-sized ConfigureRequest.
Set zero GTK frame extents before requesting geometry for the profiled
layers, while preserving an existing property. Initialize the hint once
per X window and reset the cache when the native window is destroyed.

The default path and real application windows retain their state policy.

Co-Authored-By: OpenAI Codex <noreply@openai.com>
---
 dlls/winex11.drv/window.c      | 67 +++++++++++++++++++++++++++++++++-
 dlls/winex11.drv/x11drv.h      |  2 +
 dlls/winex11.drv/x11drv_main.c |  1 +
 3 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index a6c7697..fee2cd6 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -120,6 +120,8 @@ static const WCHAR focus_time_prop[] =
 static const WCHAR frameless_window_prop[] =
     {'_','_','w','i','n','e','_','w','i','n','3','2','u','_','f','r','a','m','e','l','e','s','s',0};
 
+static void update_layered_helper_frame_extents( struct x11drv_win_data *data );
+
 static const char *debugstr_mwm_hints( const MwmHints *hints )
 {
     return wine_dbg_sprintf( "%lx,%lx", hints->functions, hints->decorations );
@@ -1381,6 +1383,7 @@ static void set_wm_hints( struct x11drv_win_data *data )
     set_size_hints( data, style );
     set_mwm_hints( data, style, ex_style );
     set_style_hints( data, style, ex_style );
+    update_layered_helper_frame_extents( data );
 }
 
 
@@ -1627,6 +1630,7 @@ static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL abo
     data->desired_state.above = above;
     if (data->state_locks) return; /* win32 state is being updated, delay the change */
     if (!data->whole_window) return; /* no window, nothing to update */
+    update_layered_helper_frame_extents( data );
     if (EqualRect( old_rect, new_rect ) && (old_above || !above || data->managed)) return; /* rects are the same, no need to be raised, nothing to update */
     if (window_needs_config_change_delay( data ))
     {
@@ -1706,6 +1710,64 @@ static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL abo
     if (net_wm_state != -1) window_set_net_wm_state( data, net_wm_state );
 }
 
+/* A per-application profile may identify owned transparent decoration
+ * layers which must never hide host panels merely by covering a monitor. */
+static BOOL suppress_layered_helper_fullscreen( struct x11drv_win_data *data, UINT style, UINT ex_style )
+{
+    const char *value = getenv( "WINE_X11_NO_FULLSCREEN_LAYERED_HELPER" );
+    const char *profile_class = getenv( "WINE_X11_NO_FULLSCREEN_HELPER_CLASS" );
+    const UINT layered_helper = WS_EX_LAYERED | WS_EX_TRANSPARENT;
+    WCHAR name[256], expected[256];
+    UNICODE_STRING class_name = {0, sizeof(name), name};
+    ULONG bytes;
+    DWORD owner_pid, pid;
+    HWND owner;
+    UINT owner_style, length;
+
+    if (!value || strcmp( value, "1" ) || !profile_class || !*profile_class) return FALSE;
+    if ((ex_style & layered_helper) != layered_helper || (ex_style & WS_EX_APPWINDOW)) return FALSE;
+    if (style & (WS_CHILD | WS_CAPTION | WS_THICKFRAME | WS_MAXIMIZE)) return FALSE;
+    if (!(owner = NtUserGetWindowRelative( data->hwnd, GW_OWNER ))) return FALSE;
+    owner_style = NtUserGetWindowLongW( owner, GWL_STYLE );
+    if ((owner_style & (WS_CAPTION | WS_CHILD)) != WS_CAPTION) return FALSE;
+    if (!NtUserGetWindowThread( owner, &owner_pid ) ||
+        !NtUserGetWindowThread( data->hwnd, &pid ) || owner_pid != pid) return FALSE;
+    if (strlen( profile_class ) > 1020 ||
+        RtlUTF8ToUnicodeN( expected, sizeof(expected), &bytes, profile_class, strlen(profile_class) ) ||
+        !bytes || bytes > sizeof(name) - sizeof(WCHAR)) return FALSE;
+    length = NtUserGetClassName( data->hwnd, FALSE, &class_name );
+    return bytes == length * sizeof(WCHAR) && !memcmp( name, expected, bytes );
+}
+
+/* Mutter may promote a monitor-sized ConfigureRequest to fullscreen even
+ * without an EWMH request. Mark opted-in decoration layers as client framed
+ * before sending their geometry, without replacing an application's hint. */
+static void update_layered_helper_frame_extents( struct x11drv_win_data *data )
+{
+    const char *enabled = getenv( "WINE_X11_NO_FULLSCREEN_LAYERED_HELPER" );
+    const char *profile_class = getenv( "WINE_X11_NO_FULLSCREEN_HELPER_CLASS" );
+    unsigned long count, remaining, extents[4] = {0};
+    unsigned char *value = NULL;
+    Atom type;
+    int format;
+    UINT style, ex_style;
+
+    if (!data->whole_window || data->embedded || data->helper_frame_extents_checked) return;
+    if (!enabled || strcmp( enabled, "1" ) || !profile_class || !*profile_class) return;
+    if (!X11DRV_HasWindowManager( "Mutter" )) return;
+    style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+    ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
+    if (!suppress_layered_helper_fullscreen( data, style, ex_style )) return;
+    if (XGetWindowProperty( data->display, data->whole_window, x11drv_atom(_GTK_FRAME_EXTENTS),
+                           0, 0, False, AnyPropertyType, &type, &format, &count, &remaining, &value ))
+        return;
+    if (value) XFree( value );
+    if (type == None)
+        XChangeProperty( data->display, data->whole_window, x11drv_atom(_GTK_FRAME_EXTENTS), XA_CARDINAL,
+                         32, PropModeReplace, (unsigned char *)extents, ARRAY_SIZE(extents) );
+    data->helper_frame_extents_checked = TRUE;
+}
+
 /***********************************************************************
  *     update_net_wm_states
  */
@@ -1722,18 +1784,18 @@ static void update_net_wm_states( struct x11drv_win_data *data )
     }
 
     style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+    ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
     if (style & WS_MINIMIZE) new_state |= data->desired_state.net_wm_state & fullscreen_mask;
     if (data->is_fullscreen)
     {
         if ((style & WS_MAXIMIZE) && (style & WS_CAPTION) == WS_CAPTION)
             new_state |= (1 << NET_WM_STATE_MAXIMIZED);
-        else if (!(style & WS_MINIMIZE))
+        else if (!(style & WS_MINIMIZE) && !suppress_layered_helper_fullscreen( data, style, ex_style ))
             new_state |= (1 << NET_WM_STATE_FULLSCREEN);
     }
     else if (style & WS_MAXIMIZE)
         new_state |= (1 << NET_WM_STATE_MAXIMIZED);
 
-    ex_style = NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE );
     if (data->force_below_hack)
         new_state |= (1 << NET_WM_STATE_BELOW);
     else if ((ex_style & WS_EX_TOPMOST) &&
@@ -3049,6 +3111,7 @@ static void destroy_whole_window( struct x11drv_win_data *data, BOOL already_des
     }
     if (data->whole_colormap) XFreeColormap( data->display, data->whole_colormap );
     data->whole_window = data->client_window = 0;
+    data->helper_frame_extents_checked = FALSE;
     data->whole_colormap = 0;
     data->managed = FALSE;
 
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 027672e..e472c3f 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -559,6 +559,7 @@ enum x11drv_atoms
     XATOM__NET_WM_WINDOW_TYPE_NORMAL,
     XATOM__NET_WM_WINDOW_TYPE_UTILITY,
     XATOM__NET_WORKAREA,
+    XATOM__GTK_FRAME_EXTENTS,
     XATOM__GTK_WORKAREAS_D0,
     XATOM__XEMBED,
     XATOM__XEMBED_INFO,
@@ -707,6 +708,7 @@ struct x11drv_win_data
     UINT        reparenting : 1; /* window is being reparented, likely from a decoration change */
     UINT        is_resizable : 1; /* window is allowed to be resized by the window manager */
     UINT        net_wm_state_hack : 1; /* hacking around KWin sticky fullscreen windows */
+    UINT        helper_frame_extents_checked : 1; /* initialized the opted-in CSD hint for this X window */
     UINT        force_below_hack : 1; /* hacking fullscreen black window which is supposed to be order after another window */
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
diff --git a/dlls/winex11.drv/x11drv_main.c b/dlls/winex11.drv/x11drv_main.c
index 87959b7..a55358b 100644
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -170,6 +170,7 @@ const char * const X11DRV_atom_names[NB_XATOMS - FIRST_XATOM] =
     "_NET_WM_WINDOW_TYPE_NORMAL",
     "_NET_WM_WINDOW_TYPE_UTILITY",
     "_NET_WORKAREA",
+    "_GTK_FRAME_EXTENTS",
     "_GTK_WORKAREAS_D0",
     "_XEMBED",
     "_XEMBED_INFO",
-- 
2.53.0

