From d7a616507d8de7a919ddb5280dc0bde90708e4fe Mon Sep 17 00:00:00 2001
From: "2524369985@qq.com" <2524369985@qq.com>
Date: Tue, 17 Nov 2026 17:46:40 +0800
Subject: [PATCH] winex11: Derive alpha input shapes from the composed
 destination.

A presented child surface contains only a subset of the top-level content.
Using its alpha pixels to replace the entire top-level input region makes
opaque parent controls unreachable.

In the existing alpha opt-in mode, sample the whole destination after the
blit, using the destination geometry and origin. Keep the legacy luma shape
path and the alpha-disabled paths unchanged.

Co-Authored-By: OpenAI Codex <noreply@openai.com>
---
 dlls/winex11.drv/init.c | 42 +++++++++++++++++++++++++++++++----------
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index f00a825..8f323de 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -575,7 +575,7 @@ static int overlay_xshm_error( Display *display, XErrorEvent *event, void *arg )
 }
 
 /* (re)create a shared-memory XImage matching the client window's visual and depth */
-static BOOL ensure_shm_image( struct x11drv_client_surface *surface, unsigned int width,
+static BOOL ensure_shm_image( struct x11drv_client_surface *surface, Window window, unsigned int width,
                               unsigned int height )
 {
     static int shm_supported = -1;
@@ -596,7 +596,7 @@ static BOOL ensure_shm_image( struct x11drv_client_surface *surface, unsigned in
         surface->shm_image = NULL;
     }
 
-    if (!XGetWindowAttributes( gdi_display, surface->window, &attr )) return FALSE;
+    if (!XGetWindowAttributes( gdi_display, window, &attr )) return FALSE;
 
     surface->shm_info.shmid = -1;
     if (!(image = XShmCreateImage( gdi_display, attr.visual, attr.depth, ZPixmap, NULL,
@@ -662,7 +662,8 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
     BOOL actually_visible = FALSE, borrowed = FALSE, direct;
     XRectangle *rects;
     XImage *image = NULL;
-    Window window;
+    Window window, drawable;
+    int offset_x = surface->changes.x, offset_y = surface->changes.y;
     /* SHAPE mode clips the bounding region (visual); ALPHA mode sets the INPUT region
        (mouse click-through on transparent areas) while the ARGB visual handles the
        transparency. Input-shape changes don't repaint, so this adds click-through
@@ -677,6 +678,7 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
     width = surface->rect.right - surface->rect.left;
     height = surface->rect.bottom - surface->rect.top;
     if (!width || !height || !(window = X11DRV_get_whole_window( toplevel ))) return TRUE;
+    drawable = surface->window;
 
     /* The input region follows UI layout, not frame rate, so sample it on a clock instead of
        per present. SHAPE mode stays per-present, where the readback is what's visible. */
@@ -687,6 +689,20 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
         if (!layered_overlay_input_shape_enabled()) return TRUE;
         if (now - surface->shape_last_sample < layered_overlay_shape_interval()) return TRUE;
         surface->shape_last_sample = now;
+
+        /* A child surface only describes part of the window. Replacing the whole
+         * input region with its pixels makes the parent's caption and controls
+         * unreachable. Read the composed destination after presenting instead. */
+        {
+            Window root;
+            int x, y;
+            unsigned int border, depth;
+
+            if (!XGetGeometry( gdi_display, window, &root, &x, &y, &width, &height, &border, &depth ))
+                return TRUE;
+        }
+        drawable = window;
+        offset_x = offset_y = 0;
     }
 
     cols = (width + 3) / 4;
@@ -705,13 +721,13 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
 
     /* MIT-SHM avoids copying the whole image over the X socket */
 #ifdef HAVE_LIBXXSHM
-    if (ensure_shm_image( surface, width, height ))
+    if (ensure_shm_image( surface, drawable, width, height ))
     {
         BOOL got;
 
         /* a window reaching past the root window fails here, but not in XGetImage */
         X11DRV_expect_error( gdi_display, overlay_xshm_error, NULL );
-        got = XShmGetImage( gdi_display, surface->window, surface->shm_image, 0, 0, AllPlanes );
+        got = XShmGetImage( gdi_display, drawable, surface->shm_image, 0, 0, AllPlanes );
         if (X11DRV_check_error()) got = FALSE;
         if (got)
         {
@@ -721,7 +737,7 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
     }
 #endif
     if (!image &&
-        !(image = XGetImage( gdi_display, surface->window, 0, 0, width, height, AllPlanes, ZPixmap )))
+        !(image = XGetImage( gdi_display, drawable, 0, 0, width, height, AllPlanes, ZPixmap )))
         return TRUE;
 
     direct = image_is_native_32bpp( image );
@@ -780,8 +796,8 @@ static BOOL update_layered_overlay_shape( struct x11drv_client_surface *surface,
             {
                 unsigned int end = *age ? width : x;
 
-                rects[count].x = surface->changes.x + run_start;
-                rects[count].y = surface->changes.y + y;
+                rects[count].x = offset_x + run_start;
+                rects[count].y = offset_y + y;
                 rects[count].width = end - run_start;
                 rects[count].height = min( 4, height - y );
                 count++;
@@ -859,9 +875,12 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
         /* Layered overlay: shape check runs first. If it returns FALSE the client
            window holds the D3D clear colour — skip the blit so the previous correct
            pixels stay in the whole window, avoiding flicker. */
-        if (update_layered_overlay_shape( surface, toplevel ))
+        if (layered_overlay_alpha_enabled() || update_layered_overlay_shape( surface, toplevel ))
+        {
             NtGdiStretchBlt( hdc, 0, 0, surface->rect.right - surface->rect.left, surface->rect.bottom - surface->rect.top,
                              surface->hdc_src, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
+            if (layered_overlay_alpha_enabled()) update_layered_overlay_shape( surface, toplevel );
+        }
         if (region) NtGdiDeleteObjectApp( region );
         window_surface_release( win_surface );
         return;
@@ -895,9 +914,12 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
         set_dc_drawable( surface->hdc_dst, window, &rect_dst, IncludeInferiors, &vis );
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
-    if (update_layered_overlay_shape( surface, toplevel ))
+    if (layered_overlay_alpha_enabled() || update_layered_overlay_shape( surface, toplevel ))
+    {
         NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
                          surface->hdc_src, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
+        if (layered_overlay_alpha_enabled()) update_layered_overlay_shape( surface, toplevel );
+    }
     XFlush( gdi_display );
 
 done:
-- 
2.53.0

